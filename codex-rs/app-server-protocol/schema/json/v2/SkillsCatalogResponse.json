{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LegacyAppPathString": {
      "type": "string"
    },
    "SkillCatalogMetadata": {
      "properties": {
        "allowImplicitInvocation": {
          "description": "False hides the skill from the automatic model catalog, not from explicit selection.",
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "allOf": [
            {
              "$ref": "#/definitions/LegacyAppPathString"
            }
          ],
          "description": "Environment-native SKILL.md path, including for executor-backed entries."
        },
        "pluginId": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "description": "Pass executor skill:// selectors unchanged in UserInput::Mention.path. Host paths retain the existing UserInput::Skill.path input contract.",
          "type": "string"
        },
        "shortDescription": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "allowImplicitInvocation",
        "description",
        "enabled",
        "name",
        "path",
        "selector"
      ],
      "type": "object"
    },
    "SkillsCatalogEntry": {
      "properties": {
        "cwd": {
          "$ref": "#/definitions/LegacyAppPathString"
        },
        "environmentId": {
          "type": "string"
        },
        "errors": {
          "description": "Discovery errors belong to this environment; other entries remain available.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/definitions/SkillCatalogMetadata"
          },
          "type": "array"
        },
        "supportsSkillConfig": {
          "description": "Whether this environment applies user-level skills.config enablement rules.",
          "type": "boolean"
        }
      },
      "required": [
        "cwd",
        "environmentId",
        "errors",
        "skills",
        "supportsSkillConfig"
      ],
      "type": "object"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/SkillsCatalogEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "SkillsCatalogResponse",
  "type": "object"
}